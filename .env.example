# Data source: "demo" uses the explicitly labelled synthetic adapter (default while the
# backend exposes no assessment endpoints). "live" talks to VITE_API_BASE_URL and never
# falls back to demo data on error.
VITE_DATA_MODE=demo

# Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Upload constraints (must match the backend once it enforces them).
VITE_MAX_UPLOAD_MB=25
